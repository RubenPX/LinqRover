<div class="h-full min-h-0 flex gap-3">
    <div class="flex-1 min-w-0 min-h-0 flex flex-col gap-2">
        <div class="@(_result is { Columns.Count: > 0 } ? "h-64 shrink-0" : "flex-1 min-h-0 flex flex-col")">
            <SqlEditor Profile="@Profile" Schema="@Schema" TableNames="@TableNames" InitialText="@_code" Language="csharp"
                       Busy="_busy" OnRun="RunAsync" Completer="@CompleteAsync" />
        </div>

        @switch (_completionState)
        {
            case CompletionState.Preparing:
                <div class="shrink-0 flex items-center gap-1 text-xs opacity-70">
                    <span class="loading loading-spinner loading-xs"></span>
                    Preparando el autocompletado (Roslyn)…
                </div>
                break;
            case CompletionState.Failed:
                <div class="shrink-0 text-xs text-warning" title="@_completionError">
                    Autocompletado básico: no se pudo preparar Roslyn.
                </div>
                break;
        }

        @if (_error is not null)
        {
            <div role="alert" class="alert alert-error alert-soft text-sm py-2 shrink-0 font-mono-sql whitespace-pre-wrap">@_error</div>
        }
        else if (_status is not null)
        {
            <div class="shrink-0 text-xs opacity-70">@_status</div>
        }

        @if (_result is { Columns.Count: > 0 })
        {
            <div class="flex-1 min-h-0 relative">
                <div class="absolute inset-0 flex flex-col">
                    <DataViewer @key="_key" LoadPage="LoadPage" PageSize="30" />
                </div>
            </div>
        }
    </div>

    @if (Columns.Count > 0)
    {
        <aside class="w-56 shrink-0 min-h-0 flex flex-col border border-base-300 rounded-box bg-base-100">
            <div class="px-3 py-2 border-b border-base-300 text-xs font-semibold">
                Columnas de @Table <span class="opacity-60 font-normal">(@Columns.Count)</span>
            </div>
            <ul class="flex-1 min-h-0 overflow-y-auto p-1 text-xs font-mono-sql">
                @foreach (var column in Columns)
                {
                    <li class="flex items-center justify-between gap-2 px-2 py-0.5 rounded hover:bg-base-200" title="@column.Name : @column.DataType">
                        <span class="truncate @(column.IsPrimaryKey ? "font-semibold" : "")">@column.Name</span>
                        <span class="opacity-50 whitespace-nowrap">@(column.IsPrimaryKey ? "PK " : "")@column.DataType</span>
                    </li>
                }
            </ul>
        </aside>
    }
</div>

@code {
    [Inject] private DatabaseProviders Providers { get; set; } = default!;

    [Parameter, EditorRequired] public DbConnectionProfile Profile { get; set; } = default!;
    [Parameter, EditorRequired] public string Schema { get; set; } = "";
    /// <summary>Nombres de las tablas del esquema, para el autocompletado de db.</summary>
    [Parameter] public IReadOnlyList<string> TableNames { get; set; } = [];
    /// <summary>Tabla seleccionada en el Workspace. Se usa para generar el script de ejemplo.</summary>
    [Parameter] public string? Table { get; set; }
    /// <summary>Columnas de la tabla seleccionada, para el panel lateral.</summary>
    [Parameter] public IReadOnlyList<ColumnInfo> Columns { get; set; } = [];

    private const int MaxRows = 1000;

    private string _code = "";
    private bool _busy;
    private QueryResult? _result;
    private string _key = "";
    private string? _status;
    private string? _error;

    private enum CompletionState { Preparing, Ready, Failed }

    private CompletionState _completionState = CompletionState.Preparing;
    private string? _completionError;
    private string? _preparedKey;

    protected override void OnParametersSet()
    {
        // Script de ejemplo: consulta sobre la tabla seleccionada (las tablas están en `db` como entidades de tipo compartido).
        _code = string.IsNullOrEmpty(Table)
            ? "// Selecciona una tabla en el Workspace para ver sus clases\nreturn db;"
            : $"var query = db.{ClassGenerator.ContextMemberName(Table)}\n    .Take(30);\n\nreturn query;";

        // Se prepara al abrir la pestaña (no al primer Ctrl+Espacio) para avisar al usuario mientras tanto.
        var key = $"{Profile.Id}|{Schema}";
        if (key != _preparedKey)
        {
            _preparedKey = key;
            _ = PrepareCompletionAsync();
        }
    }

    private async Task PrepareCompletionAsync()
    {
        _completionState = CompletionState.Preparing;
        try
        {
            await new Services.ScriptService(Providers).PrepareCompletionAsync(Profile, Schema);
            _completionState = CompletionState.Ready;
        }
        catch (Exception ex)
        {
            _completionState = CompletionState.Failed;
            _completionError = ex.Message;
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task RunAsync(string code)
    {
        _busy = true;
        _error = null;
        _status = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(90));
            var service = new Services.ScriptService(Providers);
            _result = await service.RunAsync(Profile, Schema, code, MaxRows, cts.Token);
            _key = Guid.NewGuid().ToString();

            var ms = _result.Elapsed.TotalMilliseconds.ToString("0");
            _status = $"{_result.Rows.Count} filas{(_result.Truncated ? $" (se muestran las primeras {MaxRows})" : "")} · {ms} ms (revertido)";
        }
        catch (Exception ex)
        {
            _result = null;
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private Task<IReadOnlyList<CompletionSuggestion>> CompleteAsync(string code, int offset) =>
        new Services.ScriptService(Providers).CompleteAsync(Profile, Schema, code, offset);

    private Task<PageResult> LoadPage(int pageIndex, int pageSize)
    {
        var r = _result!;
        var rows = r.Rows.Skip(pageIndex * pageSize).Take(pageSize).ToList();
        return Task.FromResult(new PageResult(r.Columns, rows, r.Rows.Count, pageIndex, pageSize));
    }
}
