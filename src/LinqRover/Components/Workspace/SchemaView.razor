<div class="flex flex-col gap-3 h-full min-h-0">
    <div>
        <h2 class="font-semibold font-mono-sql">@TableName</h2>
        <p class="text-xs opacity-60">@Columns.Count columnas</p>
    </div>
    <div class="overflow-auto border border-base-300 rounded-box">
        <table class="table table-sm">
            <thead>
                <tr><th>Columna</th><th>Tipo</th><th>Nulo</th><th>Clave</th></tr>
            </thead>
            <tbody>
                @foreach (var col in Columns)
                {
                    <tr>
                        <td class="font-mono-sql">@col.Name</td>
                        <td class="font-mono-sql opacity-70">@col.DataType</td>
                        <td class="opacity-60">@(col.IsNullable ? "sí" : "no")</td>
                        <td>
                            @if (col.IsPrimaryKey)
                            {
                                <span class="badge badge-warning badge-sm">PK</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    [Parameter] public string TableName { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<ColumnInfo> Columns { get; set; } = [];
}
