<div class="h-full flex items-center justify-center">
    <div class="text-center border-2 border-dashed border-base-300 rounded-box p-10 max-w-md">
        <p class="font-semibold">@Title</p>
        <p class="text-sm opacity-60 mt-1">@Text</p>
        <span class="badge badge-ghost badge-sm mt-4">Próximamente</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string Text { get; set; } = "";
}
