<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LinqRover</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <SatelliteResourceLanguages>es-ES</SatelliteResourceLanguages>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Services\**\*.cs" />
    <RazorComponent Include="Components\**\*.razor" />
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EdoardoTona.Rustino.Blazor" Version="0.6.0-preview.2" />
    <PackageReference Include="Z.Blazor.Diagrams" Version="3.0.4.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinqRover.Core\LinqRover.Core.csproj" />
    <ProjectReference Include="..\LinqRover.QueryBuilder\LinqRover.QueryBuilder.csproj" />
  </ItemGroup>

  <!-- Estilos Tailwind y copia de Monaco antes del build (requiere npm install una vez en esta carpeta) -->
  <Target Name="BuildSharedAssets" BeforeTargets="BeforeBuild">
    <Exec Command="npm run build:css" Condition="Exists('node_modules')" />
    <Exec Command="npm run copy:monaco" Condition="Exists('node_modules') And !Exists('wwwroot\lib\monaco\vs\loader.js')" />
  </Target>
</Project>
