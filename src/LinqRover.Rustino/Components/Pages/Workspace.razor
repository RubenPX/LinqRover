@page "/workspace/{ProfileId:guid}"
@implements IDisposable
@inject ProfileStore Store
@inject DatabaseProviders Providers
@inject WorkbenchState Workbench
@using LinqRover.QueryBuilder.Editor

<div class="flex flex-1 min-h-0 min-w-0">
    @* Explorador lateral: tablas de la conexión, colapsable (no se muestra mientras carga) *@
    @if (_profile is not null && !_loading)
    {
        @if (_sidebarCollapsed)
        {
            <div class="vs-activitybar">
                <button class="vs-activity-item" aria-label="Mostrar tablas" title="Mostrar tablas" @onclick="() => _sidebarCollapsed = false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M20 7h-3a2 2 0 0 1-2-2V2" />
                        <path d="M9 18a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h7l4 4v10a2 2 0 0 1-2 2Z" />
                        <path d="M3 7.6v12.8A1.6 1.6 0 0 0 4.6 22h9.8" />
                    </svg>
                </button>
            </div>
        }
        else
        {
            <aside class="vs-sidebar">
                <div class="vs-sidebar-header">
                    <span class="truncate">Explorador</span>
                    <button class="vs-icon-btn" aria-label="Ocultar tablas" title="Ocultar tablas" @onclick="() => _sidebarCollapsed = true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M15 18l-6-6 6-6" />
                        </svg>
                    </button>
                </div>

                <div class="vs-section-header" title="@_profile.Name · @_profile.Engine.DisplayName()">
                    <span class="truncate">@_profile.Name</span>
                </div>
                <div class="px-2 py-2">
                    <select class="select select-sm w-full" aria-label="Esquema" @onchange="OnSchemaChanged" @onfocus="EnsureSchemaListAsync">
                        @foreach (var schema in _schemas)
                        {
                            <option value="@schema" selected="@(schema == _schema)">@schema</option>
                        }
                    </select>
                </div>

                <div class="vs-section-header"><span>Tablas</span></div>
                <div class="flex-1 min-h-0 px-2 pt-2 pb-2 flex flex-col">
                    <TablesPanel Tables="@_tables" SelectedTable="@_selected" OnSelect="OpenTableAsync" LoadColumns="LoadColumnsAsync" />
                </div>
            </aside>
        }
    }

    @* Área del editor: pestañas de consulta y contenido *@
    <div class="vs-editor-area">
        @if (_error is not null)
        {
            <div role="alert" class="alert alert-error alert-soft rounded-none flex items-center gap-3 px-3 py-1.5 shrink-0">
                <span class="text-sm">@_error</span>
                <button class="btn btn-sm" @onclick="Retry">Reintentar</button>
            </div>
        }

        @if (_loading)
        {
            <div class="flex-1 flex flex-col items-center justify-center gap-2 text-sm">
                <div class="flex items-center gap-2 opacity-80">
                    <span class="loading loading-spinner"></span>
                    <span>@_loadStage</span>
                </div>
                <span class="text-xs opacity-50">@LoadElapsed()</span>
            </div>
        }
        else if (_profile is not null)
        {
            @* Pestañas del editor (solo cuando la carga inicial ha terminado) *@
            <div class="vs-tabs" role="tablist" aria-label="Pestañas de consulta">
                @foreach (var doc in _docs)
                {
                    <div role="tab" aria-selected="@(doc.Id == _activeDoc)" class="vs-tab @(doc.Id == _activeDoc ? "is-active" : "")"
                         @onclick="() => _activeDoc = doc.Id">
                        <span class="text-[13px] truncate max-w-48">@doc.Title</span>
                        <button class="vs-tab-close" aria-label="Cerrar pestaña" title="Cerrar"
                                @onclick="() => CloseDoc(doc)" @onclick:stopPropagation="true">
                            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                <path d="M8 8.7l3.6 3.6.7-.7L8.7 8l3.6-3.6-.7-.7L8 7.3 4.4 3.7l-.7.7L7.3 8l-3.6 3.6.7.7L8 8.7z" />
                            </svg>
                        </button>
                    </div>
                }

                <button class="vs-tab-action" aria-label="Nueva pestaña" title="Nueva pestaña"
                        @onclick="() => _showNewMenu = !_showNewMenu">
                    <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
                        <path d="M14 7v1H8v6H7V8H1V7h6V1h1v6h6z" />
                    </svg>
                </button>
            </div>

            @if (_showNewMenu)
            {
                <ul class="menu vs-popup vs-tab-menu" role="menu">
                    <li><button role="menuitem" @onclick="() => AddDoc(isSql: true)">SQL</button></li>
                    <li><button role="menuitem" @onclick="() => AddDoc(isSql: false)">EF Script</button></li>
                    <li><button role="menuitem" @onclick="AddVisualDoc">Editor visual</button></li>
                </ul>
            }

            <div class="flex-1 min-h-0 relative p-2">
                @if (_docs.Count == 0)
                {
                    <div class="h-full flex flex-col items-center justify-center gap-3 vs-muted">
                        <p class="text-sm">No hay pestañas abiertas.</p>
                        <div class="flex flex-wrap justify-center gap-2">
                            <button class="btn btn-sm" @onclick="() => AddDoc(isSql: true)">Nueva pestaña SQL</button>
                            <button class="btn btn-sm" @onclick="() => AddDoc(isSql: false)">Nueva pestaña EF Script</button>
                            <button class="btn btn-sm" @onclick="AddVisualDoc">Nueva pestaña editor visual</button>
                        </div>
                    </div>
                }

                @foreach (var doc in _docs)
                {
                    <div class="absolute inset-2 @(doc.Id == _activeDoc ? "" : "hidden")">
                        @if (doc.IsVisual)
                        {
                            <QueryDiagramEditor @key="doc.Id" Schema="@_schema" LoadColumns="LoadColumnsAsync"
                                                Engine="@_profile.Engine" Busy="@doc.Busy" OnExecute="sql => RunVisualAsync(doc, sql)"
                                                ShowResult="@(doc.Error is not null || doc.Status is not null)">
                                <ResultContent>
                                    @if (doc.Error is not null)
                                    {
                                        <div role="alert" class="alert alert-error alert-soft text-sm py-2 font-mono-sql whitespace-pre-wrap">@doc.Error</div>
                                    }
                                    else if (doc.Status is not null && doc.Result is not { Columns.Count: > 0 })
                                    {
                                        <p class="text-sm vs-muted">@doc.Status</p>
                                    }

                                    @if (doc.Result is { Columns.Count: > 0 })
                                    {
                                        <div class="flex-1 min-h-0 flex flex-col">
                                            <DataViewer @key="doc.ResultKey" LoadPage="(page, size) => LoadDocPageAsync(doc, page, size)" PageSize="30"
                                                        Elapsed="doc.Result.Elapsed"
                                                        Note="@(doc.Result.Truncated ? $"(se muestran las primeras {VisualMaxRows})" : null)" />
                                        </div>
                                    }
                                </ResultContent>
                            </QueryDiagramEditor>
                        }
                        else
                        {
                            <QueryTab @key="doc.Id" Profile="@_profile" Schema="@_schema" TableNames="@_tables"
                                      IsSql="@doc.IsSql" InitialText="@doc.Text" Active="@(doc.Id == _activeDoc)" />
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@* Detalle de una tabla: datos, esquema y diagrama *@
@if (_showTable && _selected is not null && _profile is not null)
{
    <div class="modal modal-open" role="dialog" aria-modal="true">
        <div class="modal-box w-11/12 max-w-[90vw] h-[85vh] flex flex-col gap-3">
            <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-2 min-w-0">
                    <h3 class="font-semibold font-mono-sql truncate">@_selected</h3>
                    <span class="badge badge-ghost badge-sm">@_schema</span>
                </div>
                <button class="btn btn-ghost btn-sm" aria-label="Cerrar" @onclick="() => _showTable = false">✕</button>
            </div>

            <div role="tablist" class="tabs tabs-box tabs-sm w-fit">
                <button role="tab" class="tab @(_tableTab == "data" ? "tab-active" : "")" @onclick='() => _tableTab = "data"'>Datos</button>
                <button role="tab" class="tab @(_tableTab == "schema" ? "tab-active" : "")" @onclick='() => _tableTab = "schema"'>Esquema</button>
                <button role="tab" class="tab @(_tableTab == "diagram" ? "tab-active" : "")" @onclick='() => _tableTab = "diagram"'>Diagrama</button>
            </div>

            <div class="flex-1 min-h-0 flex flex-col">
                @switch (_tableTab)
                {
                    case "data":
                        <DataViewer @key="DataKey" LoadPage="LoadPageAsync" PageSize="30" />
                        break;
                    case "schema":
                        <SchemaView TableName="@_selected" Columns="@_columns" />
                        break;
                    case "diagram":
                        <ZbdTableDiagram @key="DataKey" Profile="@_profile" Schema="@_schema" Table="@_selected"
                                         OnSelect="SelectRelatedAsync" />
                        break;
                }
            </div>
        </div>
        <div class="modal-backdrop" @onclick="() => _showTable = false"></div>
    </div>
}

@code {
    [Parameter] public Guid ProfileId { get; set; }

    /// <summary>Pestaña de consulta abierta (SQL, EF Script o editor visual).</summary>
    private sealed class QueryDocument
    {
        public Guid Id { get; } = Guid.NewGuid();
        public bool IsSql { get; init; }
        public bool IsVisual { get; init; }
        public string Title { get; init; } = "";
        /// <summary>Texto inicial del editor.</summary>
        public string Text { get; init; } = "";

        // Estado de la pestaña visual: ejecución y resultado.
        public bool Busy { get; set; }
        public string? Status { get; set; }
        public string? Error { get; set; }
        public QueryResult? Result { get; set; }
        public string ResultKey { get; set; } = "";
    }

    /// <summary>Filas máximas que trae la consulta del editor visual (igual que las pestañas SQL).</summary>
    private const int VisualMaxRows = 1000;

    private string DataKey => $"{_schema}.{_selected}";

    private DbConnectionProfile? _profile;
    private string _schema = "";
    private List<string> _schemas = [];
    private List<string> _tables = [];
    private string? _selected;
    private IReadOnlyList<ColumnInfo> _columns = [];
    private string? _error;

    // Modales de tablas
    private bool _sidebarCollapsed;
    private bool _showTable;
    private string _tableTab = "data";

    // Pestañas de consulta
    private readonly List<QueryDocument> _docs = [];
    private Guid? _activeDoc;
    private bool _showNewMenu;
    private int _sqlCount;
    private int _efCount;
    private int _visualCount;

    protected override async Task OnParametersSetAsync()
    {
        await Retry();
    }

    // Estado de la carga inicial: etapa actual y reloj para distinguir una operación lenta de una colgada.
    // Mientras es true se muestra solo el spinner: _profile se asigna pronto y no basta para saber si ya hay datos.
    private bool _loading;
    private string _loadStage = "Leyendo la conexión…";
    private DateTime _loadStarted;
    private System.Threading.Timer? _loadTicker;

    private bool _schemaListLoaded;

    /// <summary>Lee la lista completa de esquemas la primera vez que se despliega el selector.</summary>
    private async Task EnsureSchemaListAsync()
    {
        if (_schemaListLoaded || _profile is null) return;
        _schemaListLoaded = true;
        try
        {
            var all = (await Providers.Get(_profile.Engine).GetSchemasAsync(_profile)).ToList();
            if (!all.Contains(_schema)) all.Insert(0, _schema);
            _schemas = all;
        }
        catch (Exception ex)
        {
            _schemaListLoaded = false;
            _error = $"No se pudo leer la lista de esquemas: {ex.Message}";
        }
    }

    private async Task Retry()
    {
        _error = null;
        _loading = true;
        _loadStarted = DateTime.UtcNow;
        _loadStage = "Leyendo la conexión…";
        StartLoadTicker();
        try
        {
            _profile = (await Store.GetAllAsync()).FirstOrDefault(p => p.Id == ProfileId);
            if (_profile is null)
            {
                _error = "La conexión no existe. Quizá se ha eliminado.";
                return;
            }

            // Solo se carga el esquema del perfil (o el por defecto del motor). La lista completa de esquemas
            // no se pide al conectar: se lee al desplegar el selector (EnsureSchemaListAsync).
            var provider = Providers.Get(_profile.Engine);
            _schema = _profile.DefaultSchema ?? provider.GetDefaultSchema(_profile);
            _schemas = [_schema];
            _schemaListLoaded = false;
            SetStage($"Leyendo tablas de {_schema}…");
            await LoadTablesAsync();
            Workbench.OpenWorkspace(_profile.Id, _profile.Name, _profile.Engine.DisplayName(), _schema);
        }
        catch (Exception ex)
        {
            _error = $"No se pudo conectar: {ex.Message}";
        }
        finally
        {
            _loading = false;
            StopLoadTicker();
        }
    }

    private void SetStage(string stage)
    {
        _loadStage = stage;
        StateHasChanged();
    }

    /// <summary>Refresca el reloj de la pantalla de carga cada segundo mientras se espera a la base de datos.</summary>
    private void StartLoadTicker()
    {
        StopLoadTicker();
        _loadTicker = new System.Threading.Timer(_ => _ = InvokeAsync(StateHasChanged), null, 1000, 1000);
    }

    private void StopLoadTicker()
    {
        _loadTicker?.Dispose();
        _loadTicker = null;
    }

    private string LoadElapsed()
    {
        var seconds = (int)(DateTime.UtcNow - _loadStarted).TotalSeconds;
        return seconds >= 10
            ? $"{seconds} s · la base de datos tarda en responder"
            : $"{seconds} s";
    }

    private async Task OnSchemaChanged(ChangeEventArgs e)
    {
        _schema = e.Value?.ToString() ?? _schema;
        Workbench.SetSchema(_schema);
        await LoadTablesAsync();
    }

    private async Task LoadTablesAsync()
    {
        if (_profile is null) return;
        try
        {
            var tables = await Providers.Get(_profile.Engine).GetTablesAsync(_profile, _schema);
            _tables = tables.Select(t => t.Name).ToList();
            _selected = null;
            _columns = [];
        }
        catch (Exception ex)
        {
            _error = $"No se pudieron leer las tablas: {ex.Message}";
        }
    }

    private async Task OpenTableAsync(string table)
    {
        await SelectTableAsync(table);
        _tableTab = "data";
        _showTable = true;
    }

    private async Task SelectTableAsync(string? table)
    {
        _selected = table;
        _columns = [];
        if (_profile is null || table is null) return;

        try
        {
            _columns = await Providers.Get(_profile.Engine).GetColumnsAsync(_profile, _schema, table);
        }
        catch (Exception ex)
        {
            _error = $"No se pudieron leer las columnas: {ex.Message}";
        }
    }

    /// <summary>Abre una tabla vecina del diagrama. Si está en otro esquema, cambia también el esquema.</summary>
    private async Task SelectRelatedAsync(TableInfo table)
    {
        if (table.Schema != _schema)
        {
            _schema = table.Schema;
            Workbench.SetSchema(_schema);
            await LoadTablesAsync();
        }
        await SelectTableAsync(table.Name);
    }

    private Task<PageResult> LoadPageAsync(int pageIndex, int pageSize) =>
        Providers.Get(_profile!.Engine).GetPageAsync(_profile!, _schema, _selected!, pageIndex, pageSize);

    // ---- Pestañas de consulta ----

    /// <summary>
    /// Consulta inicial: SELECT de las primeras 30 filas de la primera tabla del esquema.
    /// Si el esquema no tiene tablas, la pestaña sale vacía.
    /// </summary>
    private string DefaultText(bool isSql)
    {
        const int limit = 30;
        var table = _tables.FirstOrDefault();
        if (table is null || _profile is null)
            return "";

        if (!isSql)
            return $"var query = db.{ClassGenerator.ContextMemberName(table)}\n    .Take({limit});\n\nreturn query;";

        return _profile.Engine == DatabaseEngine.SqlServer
            ? $"SELECT TOP ({limit}) * FROM {BracketName(_schema)}.{BracketName(table)}"
            : $"SELECT * FROM {QuoteName(_schema)}.{QuoteName(table)} WHERE ROWNUM <= {limit}";
    }

    private static string BracketName(string name) => "[" + name.Replace("]", "]]") + "]";

    private static string QuoteName(string name) => "\"" + name.Replace("\"", "\"\"") + "\"";


    private void AddVisualDoc()
    {
        _showNewMenu = false;
        var doc = new QueryDocument { IsVisual = true, Title = $"Visual {++_visualCount}" };
        _docs.Add(doc);
        _activeDoc = doc.Id;
    }

    private Task<IReadOnlyList<ColumnInfo>> LoadColumnsAsync(string table) =>
        Providers.Get(_profile!.Engine).GetColumnsAsync(_profile!, _schema, table);

    /// <summary>Ejecuta el SQL generado por el editor visual, dentro de una transacción que se deshace.</summary>
    private async Task RunVisualAsync(QueryDocument doc, string sql)
    {
        doc.Busy = true;
        doc.Error = null;
        doc.Status = null;
        StateHasChanged();
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(90));
            var result = await Providers.Get(_profile!.Engine).ExecuteReadOnlyAsync(_profile!, sql, VisualMaxRows, cts.Token);

            doc.Result = result;
            doc.ResultKey = Guid.NewGuid().ToString();
            var ms = result.Elapsed.TotalMilliseconds.ToString("0");
            doc.Status = result.Columns.Count == 0
                ? $"Sentencia ejecutada · {result.RowsAffected ?? 0} filas afectadas · {ms} ms (revertido)"
                : $"{result.Rows.Count} filas{(result.Truncated ? $" (se muestran las primeras {VisualMaxRows})" : "")} · {ms} ms";
        }
        catch (Exception ex)
        {
            doc.Result = null;
            doc.Error = ex.Message;
        }
        finally
        {
            doc.Busy = false;
        }
    }

    private static Task<PageResult> LoadDocPageAsync(QueryDocument doc, int pageIndex, int pageSize)
    {
        var r = doc.Result!;
        var rows = r.Rows.Skip(pageIndex * pageSize).Take(pageSize).ToList();
        return Task.FromResult(new PageResult(r.Columns, rows, r.Rows.Count, pageIndex, pageSize));
    }

    private void AddDoc(bool isSql)
    {
        _showNewMenu = false;
        var doc = new QueryDocument
        {
            IsSql = isSql,
            Title = isSql ? $"SQL {++_sqlCount}" : $"EF {++_efCount}",
            Text = DefaultText(isSql),
        };
        _docs.Add(doc);
        _activeDoc = doc.Id;
    }

    private void CloseDoc(QueryDocument doc)
    {
        var index = _docs.IndexOf(doc);
        _docs.Remove(doc);
        if (_activeDoc == doc.Id)
            _activeDoc = _docs.Count == 0 ? null : _docs[Math.Min(index, _docs.Count - 1)].Id;
    }

    public void Dispose()
    {
        StopLoadTicker();
        Workbench.CloseWorkspace();
    }
}
