@page "/"
@inject ProfileStore Store
@inject NavigationManager Nav

<div class="vs-page">
<PageHeader Title="Conexiones" Subtitle="Elige una conexión guardada o crea una nueva.">
    <button class="btn btn-primary" @onclick="OpenNew">+ Nueva conexión</button>
</PageHeader>

@if (_loadError is not null)
{
    <div role="alert" class="alert alert-error alert-soft mb-4">@_loadError</div>
}

@if (_profiles is null)
{
    <span class="loading loading-spinner loading-sm"></span>
}
else if (_profiles.Count == 0)
{
    <div class="vs-empty">
        <p class="font-semibold text-white">Todavía no tienes conexiones</p>
        <p class="text-sm vs-muted mt-1">Crea una para empezar a explorar tus tablas.</p>
    </div>
}
else
{
    <ul class="vs-list" aria-label="Conexiones guardadas">
        @foreach (var profile in _profiles)
        {
            <li class="vs-row">
                <div class="min-w-0 flex flex-col gap-0.5">
                    <div class="flex items-center gap-2 min-w-0">
                        <span class="vs-row-title truncate">@profile.Name</span>
                        <span class="badge badge-sm @(profile.Engine == DatabaseEngine.Oracle ? "badge-error" : "badge-info")">
                            @profile.Engine.DisplayName()
                        </span>
                    </div>
                    <span class="vs-row-meta font-mono-sql break-all">@profile.Host:@profile.Port / @profile.Database · @profile.User</span>
                </div>
                <div class="vs-row-actions">
                    <button class="btn btn-ghost btn-sm" @onclick="() => OpenEdit(profile)">Editar</button>
                    <button class="btn btn-ghost btn-sm text-error" @onclick="() => DeleteAsync(profile)">Eliminar</button>
                    <button class="btn btn-primary btn-sm" @onclick="() => Connect(profile)">Conectar</button>
                </div>
            </li>
        }
    </ul>
}

@if (_showForm)
{
    <ConnectionForm Profile="@_editing" OnSaved="OnFormSaved" OnCancel="CloseForm" />
}
</div>

@code {
    private List<DbConnectionProfile>? _profiles;
    private DbConnectionProfile? _editing;
    private bool _showForm;
    private string? _loadError;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            _profiles = (await Store.GetAllAsync()).ToList();
            _loadError = null;
        }
        catch (Exception ex)
        {
            _profiles ??= [];
            _loadError = $"No se pudieron leer las conexiones: {ex.Message}";
        }
    }

    private void OpenNew()
    {
        _editing = null;
        _showForm = true;
    }

    private void OpenEdit(DbConnectionProfile profile)
    {
        _editing = profile;
        _showForm = true;
    }

    private void CloseForm() => _showForm = false;

    private void Connect(DbConnectionProfile profile) => Nav.NavigateTo($"workspace/{profile.Id}");

    private async Task OnFormSaved()
    {
        _showForm = false;
        await ReloadAsync();
    }

    private async Task DeleteAsync(DbConnectionProfile profile)
    {
        try
        {
            await Store.DeleteAsync(profile.Id);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"No se pudo eliminar: {ex.Message}";
        }
    }
}
